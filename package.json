{
  "name": "beutl-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @beutl/web dev",
    "dev:admin": "pnpm --filter @beutl/admin dev",
    "build": "pnpm --filter @beutl/web build && pnpm --filter @beutl/api typecheck && pnpm --filter @beutl/admin build",
    "start": "pnpm --filter @beutl/web start",
    "lint": "pnpm --filter @beutl/web lint && pnpm --filter @beutl/admin lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm deploy:web",
    "deploy:web": "pnpm --filter @beutl/web run deploy",
    "deploy:api": "pnpm --filter @beutl/api run deploy",
    "deploy:admin": "pnpm --filter @beutl/admin run deploy",
    "upload": "pnpm upload:web",
    "upload:web": "pnpm --filter @beutl/web upload",
    "upload:api": "pnpm --filter @beutl/api upload",
    "upload:admin": "pnpm --filter @beutl/admin upload",
    "preview": "pnpm --filter @beutl/web preview"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "hono": "^4.13.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.0",
      "@types/react-dom": "19.1.1",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.9",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "undici": "7.29.0",
      "postcss": "8.5.26",
      "lodash": "4.18.1",
      "fast-xml-parser": "5.7.0",
      "fast-xml-builder": "1.1.7",
      "flatted": "3.4.4",
      "yaml": "2.9.0",
      "body-parser": "2.3.0",
      "qs": "6.15.3",
      "path-to-regexp@8": "8.4.2",
      "ws@7": "7.5.13",
      "sharp": "0.35.3",
      "form-data": "4.0.6",
      "defu": "6.1.7",
      "@typescript-eslint/eslint-plugin": "8.66.0",
      "@typescript-eslint/parser": "8.66.0",
      "@typescript-eslint/typescript-estree": "8.66.0",
      "@typescript-eslint/utils": "8.66.0"
    }
  },
  "packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a"
}
