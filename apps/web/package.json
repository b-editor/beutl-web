{
  "name": "@beutl/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build --webpack",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "reconcile:package-payments": "node --env-file-if-exists=.env scripts/reconcile-package-payments.mjs",
    "backfill:package-payment-amounts": "node --env-file-if-exists=.env scripts/backfill-package-payment-amounts.mjs",
    "reconcile:stale-subscriptions": "node --env-file-if-exists=.env scripts/reconcile-stale-subscriptions.mjs",
    "migrate:fresh-cockroach": "node --env-file-if-exists=.env scripts/migrate-fresh-cockroach.mjs",
    "migrate:ai-usage": "node --env-file-if-exists=.env scripts/migrate-ai-usage.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@beutl/api": "workspace:*",
    "@beutl/core": "workspace:*",
    "@beutl/db": "workspace:*",
    "@beutl/email": "workspace:*",
    "@beutl/i18n": "workspace:*",
    "@beutl/next": "workspace:*",
    "@beutl/ui": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "@opennextjs/cloudflare": "^1.20.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.7",
    "country-to-currency": "^3.0.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^0.575.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "^7.8.5",
    "stripe": "^20.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "^7.8.0",
    "dotenv": "17.4.2",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a"
}
