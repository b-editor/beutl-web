{
  "name": "@beutl/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --turbopack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "reconcile:package-payments": "node --env-file-if-exists=.env scripts/reconcile-package-payments.mjs",
    "backfill:package-payment-amounts": "node --env-file-if-exists=.env scripts/backfill-package-payment-amounts.mjs",
    "reconcile:stale-subscriptions": "node --env-file-if-exists=.env scripts/reconcile-stale-subscriptions.mjs",
    "migrate:fresh-cockroach": "node --env-file-if-exists=.env scripts/migrate-fresh-cockroach.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "postinstall": "node ../../scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@beutl/ui": "workspace:*",
    "@better-auth/passkey": "^1.6.26",
    "@beutl/api": "workspace:*",
    "@beutl/core": "workspace:*",
    "@beutl/db": "workspace:*",
    "@beutl/email": "workspace:*",
    "@beutl/i18n": "workspace:*",
    "@beutl/next": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-table": "^8.21.2",
    "better-auth": "^1.6.26",
    "country-to-currency": "^2.0.2",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.34.3",
    "hono": "^4.13.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.575.0",
    "next": "15.5.22",
    "pg": "^8.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "semver": "^7.7.1",
    "stripe": "^20.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.5.22",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.16.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@types/semver": "^7.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.22",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.119.0"
  },
  "packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a"
}
