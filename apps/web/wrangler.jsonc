{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext の worker をそのまま指さず、本文の大きさを見る入口で包む。
  // 生成されるハンドラは利用者の middleware より先に本文をまるごと持つので、
  // 抱える前に断れるのはここだけ。中身は worker.js を参照。
  "main": "worker.js",
  "name": "beutl-web",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
    // Propagate a browser reload/navigation through Request.signal so long AI
    // submissions release their Worker resources when the client disconnects.
    "enable_request_signal",
  ],
  "keep_vars": true,
  // Create these account secrets before deploying. See docs/deployment.md#secrets-store.
  "secrets_store_secrets": [
    { "binding": "BETTER_AUTH_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BETTER_AUTH_SECRET" },
    { "binding": "AUTH_GOOGLE_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_GOOGLE_SECRET" },
    { "binding": "AUTH_GITHUB_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_GITHUB_SECRET" },
    { "binding": "AUTH_RESEND_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_RESEND_KEY" },
    { "binding": "AUTH_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_SECRET" },
    { "binding": "GITHUB_PAT", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "GITHUB_PAT" },
    { "binding": "IPINFO_TOKEN", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "IPINFO_TOKEN" },
    { "binding": "JWT_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "JWT_SECRET" },
    { "binding": "AI_IMAGE_WORKER_JWT_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AI_IMAGE_WORKER_JWT_SECRET" },
    { "binding": "NUGET_DOWNLOAD_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "NUGET_DOWNLOAD_SECRET" },
    { "binding": "STRIPE_SECRET_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "STRIPE_SECRET_KEY" },
    { "binding": "STRIPE_ENDPOINT_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "STRIPE_ENDPOINT_SECRET" },
    { "binding": "OPENROUTER_API_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "OPENROUTER_API_KEY" },
    // Optional: create the secret, then uncomment its binding when using this integration.
    // S3 also requires BEUTL_S3_ENDPOINT and BEUTL_S3_BUCKET; leave disabled for R2-only storage.
    // { "binding": "BEUTL_S3_ACCESS_KEY_ID", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_ACCESS_KEY_ID" },
    // { "binding": "BEUTL_S3_SECRET_ACCESS_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_SECRET_ACCESS_KEY" },
    // { "binding": "OPENROUTER_WEBHOOK_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "OPENROUTER_WEBHOOK_SECRET" },
    // { "binding": "VERCEL_AI_GATEWAY_API_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "VERCEL_AI_GATEWAY_API_KEY" },
    // { "binding": "BEUTL_S3_SESSION_TOKEN", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_SESSION_TOKEN" },
  ],
  // The billing migration leaves old Worker preview URLs disabled.
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // This Worker owns Web pages and all public APIs, including /api/v{1,2,3}/*.
  // Keep API bindings and scheduled work in this deployment.
  "durable_objects": {
    "bindings": [{ "name": "BEUTL_GIT_REPOSITORIES", "class_name": "GitRepositoryDurableObject" }]
  },
  "migrations": [{ "tag": "hosted-git-v1", "new_sqlite_classes": ["GitRepositoryDurableObject"] }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    // Images Free is confirmed for this deployment. The Worker still requires
    // the explicit opt-in below, and content previews fall back at the quota.
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "AI_IMAGE_WORKER",
      "service": "beutl-ai-images"
    },
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "beutl-web",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    },
    // Issues は Wrangler 4.134.0 以上が必要。ここで有効にしないと次のデプロイで無効に戻る。
    "issues": {
      "enabled": true
    }
  },
  "r2_buckets": [
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "beutl-web-inc-cache",
    },
    // BEUTL_STORAGE_PROVIDER=s3 (vars) + BEUTL_S3_* (vars/secrets) sends new
    // objects to S3 compatible storage; keep this binding so objects already in
    // R2 stay readable. See docs/deployment.md#object-storage.
    {
      "binding": "BEUTL_R2_BUCKET",
      "bucket_name": "beutl-dev",
    },
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ],
  // Git enablement and JWT lifetime settings are managed remotely. Do not
  // replace existing secrets or reset an enabled Git service on deployment.
  "vars": {
    "PUBLIC_ORIGIN": "https://beutl.beditor.net",
    "BEUTL_IMAGE_FREE_TRANSFORMS_ENABLED": "true",
    "OPENROUTER_REQUEST_TIMEOUT_MS": "120000",
    "VERCEL_AI_GATEWAY_REQUEST_TIMEOUT_MS": "120000"
  }
}
