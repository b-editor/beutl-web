{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "beutl-web",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  // 同一ドメイン・パス分割: /api/v{1,2,3}/* は beutl-web-api (packages/api/wrangler.jsonc) が処理。
  // 最長一致で api パターンが優先されるため、この Worker は Web ページと
  // /api/auth・/api/contents・/api/stripe を受ける。カスタムドメインはダッシュボード側で設定済み。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "beutl-web",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "r2_buckets": [
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "beutl-web-inc-cache",
    },
    {
      "binding": "BEUTL_R2_BUCKET",
      "bucket_name": "beutl-dev",
    },
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ]
}
