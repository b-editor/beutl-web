# build/prisma use
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Better Auth configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_RP_ID="localhost"
# 管理画面 (admin.beutl.beditor.net) とセッションを共有するためのクッキードメイン。
# 共有に必要な最小のドメインを設定する (本番では beutl.beditor.net)。
# ルートドメイン (beditor.net) を指定すると配下の無関係なホストにも
# セッションクッキーが送信されるため避けること。
# 未設定時は host-only クッキーとなりサブドメイン間で共有されない。
# ローカル開発の localhost では設定しないこと。
BETTER_AUTH_COOKIE_DOMAIN=""
AUTH_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

GITHUB_PAT=""

AUTH_RESEND_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_ENDPOINT_SECRET=""
STRIPE_PRO_PRICE_ID=""
# Comma-separated immutable priceId:productId pairs retained after rotation.
STRIPE_PRO_HISTORICAL_OFFERS=""
# Storage plan: one monthly recurring Price per tier, same currency.
STRIPE_STORAGE_PRICE_ID_100GB=""
STRIPE_STORAGE_PRICE_ID_200GB=""
STRIPE_STORAGE_PRICE_ID_1TB=""
# Rotated storage Prices as priceId:productId:tier, comma separated.
STRIPE_STORAGE_HISTORICAL_OFFERS=""
STRIPE_CREDIT_PRICE_ID=""
# Must be active, allow at-period-end cancellation, and disable plan switching.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# AI (OpenRouter)
OPENROUTER_API_KEY=""
# OpenRouter workspace signing secret for terminal video callbacks.
OPENROUTER_WEBHOOK_SECRET=""
# End-to-end provider request timeout in milliseconds (defaults to 120000).
OPENROUTER_REQUEST_TIMEOUT_MS="120000"

IPINFO_TOKEN=""
METADATA_BASE_URL=""

# JWT configuration (JWT_SECRET is required; issuer/audience are optional constraints)
JWT_SECRET=""
JWT_ISSUER=""
JWT_AUDIENCE=""
JWT_EXPIRATION_MINUTES=""
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=""

# App update API
BEUTL_LATEST_VERSION=""
BEUTL_REQUIRED_VERSION=""

# Build/runtime flags
ANALYZE=""
NODE_ENV=""

# Admin user IDs (comma-separated UUIDs)
ADMIN_USER_IDS=""

# Object storage. "r2" (default) uses the BEUTL_R2_BUCKET binding from
# wrangler.jsonc; "s3" talks to any S3 compatible service with the values below.
# The Web and desktop API Workers must point at the same bucket. Only new
# objects go to the selected provider: when the other one is configured too,
# objects missing from the primary are read from it (docs/deployment.md).
BEUTL_STORAGE_PROVIDER=""
# e.g. https://s3.example.com or https://<account>.r2.cloudflarestorage.com
BEUTL_S3_ENDPOINT=""
BEUTL_S3_BUCKET=""
# Signing region. R2 and MinIO accept "auto" (default); AWS S3 needs the real one.
BEUTL_S3_REGION=""
BEUTL_S3_ACCESS_KEY_ID=""
BEUTL_S3_SECRET_ACCESS_KEY=""
BEUTL_S3_SESSION_TOKEN=""
# "true" (default) requests https://endpoint/bucket/key; "false" uses
# https://bucket.endpoint/key.
BEUTL_S3_FORCE_PATH_STYLE=""
# "true" permits an http:// endpoint (local MinIO only; credentials travel in clear).
BEUTL_S3_ALLOW_INSECURE_HTTP=""

# Git service (self-hosted Forgejo; see ../../git-server)
# Values are printed by git-server/scripts/bootstrap.sh.
# Leave these empty to run without the Git service: the repositories dashboard
# then shows a "not configured" notice instead of failing.
# Base URL of the Forgejo instance, no trailing slash.
FORGEJO_BASE_URL=""
# Site admin access token. Grants full administrative access to the instance.
FORGEJO_ADMIN_TOKEN=""
# Shared secret that the Forgejo reverse proxy requires on /api/v1/*.
FORGEJO_PROXY_SECRET=""
