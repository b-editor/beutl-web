# build/prisma use
DATABASE_URL=""
SHADOW_DATABASE_URL=""

# Better Auth configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_RP_ID="localhost"
# 管理画面 (admin.beutl.beditor.net) とセッションを共有するためのクッキードメイン。
# 共有に必要な最小のドメインを設定する (本番では beutl.beditor.net)。
# ルートドメイン (beditor.net) を指定すると配下の無関係なホストにも
# セッションクッキーが送信されるため避けること。
# 未設定時は host-only クッキーとなりサブドメイン間で共有されない。
# ローカル開発の localhost では設定しないこと。
BETTER_AUTH_COOKIE_DOMAIN=""
AUTH_SECRET=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

GITHUB_PAT=""

AUTH_RESEND_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_ENDPOINT_SECRET=""
STRIPE_PRO_PRICE_ID=""
# Comma-separated immutable priceId:productId pairs retained after rotation.
STRIPE_PRO_HISTORICAL_OFFERS=""
STRIPE_CREDIT_PRICE_ID=""
# Must be active, allow at-period-end cancellation, and disable plan switching.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# AI (OpenRouter)
OPENROUTER_API_KEY=""
# OpenRouter workspace signing secret for terminal video callbacks.
OPENROUTER_WEBHOOK_SECRET=""
# End-to-end provider request timeout in milliseconds (defaults to 120000).
OPENROUTER_REQUEST_TIMEOUT_MS="120000"

IPINFO_TOKEN=""
METADATA_BASE_URL=""

# JWT configuration (JWT_SECRET is required; issuer/audience are optional constraints)
JWT_SECRET=""
JWT_ISSUER=""
JWT_AUDIENCE=""
JWT_EXPIRATION_MINUTES=""
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=""

# App update API
BEUTL_LATEST_VERSION=""
BEUTL_REQUIRED_VERSION=""

# Build/runtime flags
ANALYZE=""
NODE_ENV=""

# Admin user IDs (comma-separated UUIDs)
ADMIN_USER_IDS=""

# Prisma Migrate targets (scripts/migrate-cockroach.mjs). The migrate:* commands
# never use DATABASE_URL as a target. Pass these on the command line for a
# production run instead of storing production URLs here.
# MIGRATE_DATABASE_URL: the database that receives the migration history.
# MIGRATE_SHADOW_DATABASE_URL: a dedicated empty Cockroach database that the
#   drift check resets on every run (the development SHADOW_DATABASE_URL works).
# MIGRATE_BASELINE_THROUGH: optional; last migration that was applied by hand.
MIGRATE_DATABASE_URL=""
MIGRATE_SHADOW_DATABASE_URL=""
MIGRATE_BASELINE_THROUGH=""
# MIGRATE_BASELINE_ACCEPT_DRIFT: optional; the drift fingerprint printed by a
#   refused migrate:baseline run, to record the history while keeping that drift.
MIGRATE_BASELINE_ACCEPT_DRIFT=""
