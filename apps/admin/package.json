    "@beutl/i18n": "workspace:*",
    "@beutl/next": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "lucide-react": "^0.575.0",
    "next": "15.5.22",
    "pg": "^8.18.0",
    "react": "19.1.0",
