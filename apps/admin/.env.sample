# Better Auth configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_RP_ID="localhost"
# Web アプリのオリジン (crossSubDomainCookies の trustedOrigins 用)
BETTER_AUTH_WEB_URL="http://localhost:3000"
# セッションクッキーの共有ドメイン。本番 (beditor.net) でのみ設定する。
# 未設定時は baseURL から自動導出される (ローカル開発の localhost では設定しない)。
BETTER_AUTH_COOKIE_DOMAIN=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# マジックリンク・メール送信 (Resend)
AUTH_RESEND_KEY=""

# Admin user IDs (comma-separated UUIDs)
ADMIN_USER_IDS=""
