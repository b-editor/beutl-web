# Better Auth configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_RP_ID="localhost"
# Web アプリ (beutl.beditor.net) とセッションを共有するためのクッキードメイン。
# 共有に必要な最小のドメインを設定する (本番では beutl.beditor.net)。
# ルートドメイン (beditor.net) を指定すると配下の無関係なホストにも
# セッションクッキーが送信されるため避けること。
# 未設定時は host-only クッキーとなりサブドメイン間で共有されない。
# ローカル開発の localhost では設定しないこと。
BETTER_AUTH_COOKIE_DOMAIN=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# マジックリンク・メール送信 (Resend)
AUTH_RESEND_KEY=""

# Admin user IDs (comma-separated UUIDs)
ADMIN_USER_IDS=""

# AI 設定画面で「1 ユニットが金額でいくらか」を出すために Stripe の価格を参照する。
# 読み取りにしか使わないので、フルの秘密鍵ではなく `prices: read` だけを許可した
# 制限付きキー (rk_...) を設定すること。管理画面に送金できる鍵を置く理由はない。
# 未設定でも画面は動く (DB に記録済みのオファーがあればそれを表示し、無ければ
# 金額の列を出さない)。
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_CREDIT_PRICE_ID=""
