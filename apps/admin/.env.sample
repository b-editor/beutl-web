# Better Auth configuration
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_RP_ID="localhost"
# Web アプリ (beutl.beditor.net) とセッションを共有するためのクッキードメイン。
# 共有に必要な最小のドメインを設定する (本番では beutl.beditor.net)。
# ルートドメイン (beditor.net) を指定すると配下の無関係なホストにも
# セッションクッキーが送信されるため避けること。
# 未設定時は host-only クッキーとなりサブドメイン間で共有されない。
# ローカル開発の localhost では設定しないこと。
BETTER_AUTH_COOKIE_DOMAIN=""

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# マジックリンク・メール送信 (Resend)
AUTH_RESEND_KEY=""

# Admin user IDs (comma-separated UUIDs)
ADMIN_USER_IDS=""

# AI model overrides. Stored admin settings take precedence over these values.
OPENROUTER_IMAGE_MODEL=""
OPENROUTER_IMAGE_EDIT_MODEL_REMOVE_BACKGROUND=""
OPENROUTER_IMAGE_EDIT_MODEL_UPSCALE=""
OPENROUTER_IMAGE_EDIT_MODEL_RESTYLE=""
OPENROUTER_IMAGE_EDIT_MODEL_REMOVE_OBJECT=""
OPENROUTER_IMAGE_EDIT_MODEL_OUTPAINT=""
OPENROUTER_STT_MODEL=""
OPENROUTER_TRANSLATION_MODEL=""
OPENROUTER_VIDEO_MODEL=""
