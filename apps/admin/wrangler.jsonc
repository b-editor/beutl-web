{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "vinext/server/fetch-handler",
  "name": "beutl-admin",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    // vinext の開発サーバーはバンドルせずに依存を読み込むため、React の開発ビルドが
    // 使う WeakRef と、依存が import する node:worker_threads が必要になる。
    // どちらも 2025-04-04 の互換日付では既定で無効。
    "enable_weak_ref",
    "enable_nodejs_worker_threads_module"
  ],
  "keep_vars": true,
  // 管理画面: admin.beutl.beditor.net にカスタムドメインで配信する。
  // ルート設定は Cloudflare ダッシュボード側で行う。
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    },
    // Issues は Wrangler 4.134.0 以上が必要。ここで有効にしないと次のデプロイで無効に戻る。
    "issues": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      // MUST MATCH beutl-web / beutl-web-api. /admin/storage がファイルの所在を
      // 確認し、ストア間で移動するのに使う。BEUTL_STORAGE_PROVIDER と BEUTL_S3_*
      // も両 Worker と同じ値にする。See docs/deployment.md#object-storage.
      "binding": "BEUTL_R2_BUCKET",
      "bucket_name": "beutl-dev"
    }
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ]
}
