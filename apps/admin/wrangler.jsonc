{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "beutl-admin",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // 管理画面: admin.beutl.beditor.net にカスタムドメインで配信する。
  // ルート設定は Cloudflare ダッシュボード側で行う。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // @opennextjs/cloudflare のインクリメンタルキャッシュ再検証 (revalidatePath)
      // は自分自身への service binding を必要とする。"service" は "name" と一致させる。
      "binding": "WORKER_SELF_REFERENCE",
      "service": "beutl-admin"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // 管理画面専用バケット。beutl-web (beutl-web-inc-cache) と共有しない
      // (パス名キーのインクリメンタルキャッシュがドメイン跨ぎで衝突し、
      // 誤ったコンテンツを配信するのを防ぐ)。
      "bucket_name": "beutl-admin-inc-cache"
    }
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ]
}
