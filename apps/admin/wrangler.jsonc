{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.js",
  "name": "beutl-admin",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "keep_vars": true,
  // Create these account secrets before deploying. See docs/deployment.md#secrets-store.
  "secrets_store_secrets": [
    { "binding": "BETTER_AUTH_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BETTER_AUTH_SECRET" },
    { "binding": "AUTH_GOOGLE_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_GOOGLE_SECRET" },
    { "binding": "AUTH_GITHUB_SECRET", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_GITHUB_SECRET" },
    { "binding": "AUTH_RESEND_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "AUTH_RESEND_KEY" },
    { "binding": "STRIPE_SECRET_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "ADMIN_STRIPE_SECRET_KEY" },
    { "binding": "BEUTL_S3_ACCESS_KEY_ID", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_ACCESS_KEY_ID" },
    { "binding": "BEUTL_S3_SECRET_ACCESS_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_SECRET_ACCESS_KEY" },
    { "binding": "GRAFANA_TEMPO_TOKEN", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "GRAFANA_TEMPO_TOKEN" },
    { "binding": "GRAFANA_LOKI_TOKEN", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "GRAFANA_LOKI_TOKEN" },
    { "binding": "VERCEL_AI_GATEWAY_API_KEY", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "VERCEL_AI_GATEWAY_API_KEY" },
    // Optional: enable only when using temporary S3 credentials.
    // { "binding": "BEUTL_S3_SESSION_TOKEN", "store_id": "de6d4a1dd7db4471aef97c1e0db1ee05", "secret_name": "BEUTL_S3_SESSION_TOKEN" },
  ],
  // 管理画面: admin.beutl.beditor.net にカスタムドメインで配信する。
  // ルート設定は Cloudflare ダッシュボード側で行う。
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // @opennextjs/cloudflare のインクリメンタルキャッシュ再検証 (revalidatePath)
      // は自分自身への service binding を必要とする。"service" は "name" と一致させる。
      "binding": "WORKER_SELF_REFERENCE",
      "service": "beutl-admin"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    },
    // Issues は Wrangler 4.134.0 以上が必要。ここで有効にしないと次のデプロイで無効に戻る。
    "issues": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      // 管理画面専用バケット。beutl-web (beutl-web-inc-cache) と共有しない
      // (パス名キーのインクリメンタルキャッシュがドメイン跨ぎで衝突し、
      // 誤ったコンテンツを配信するのを防ぐ)。
      "bucket_name": "beutl-admin-inc-cache"
    },
    {
      // MUST MATCH beutl-web. /admin/storage がファイルの所在を
      // 確認し、ストア間で移動するのに使う。BEUTL_STORAGE_PROVIDER と BEUTL_S3_*
      // も両 Worker と同じ値にする。See docs/deployment.md#object-storage.
      "binding": "BEUTL_R2_BUCKET",
      "bucket_name": "beutl-dev"
    }
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ]
}
