{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@beutl/core": ["../core/src/index.ts"],
      "@beutl/db": ["../db/src/index.ts"],
      "@beutl/i18n": ["../i18n/src/index.ts"],
      "@beutl/i18n/language": ["../i18n/src/language.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
