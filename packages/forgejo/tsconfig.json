{
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@beutl/db": ["../db/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
