{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "name": "beutl-web-api",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal"
  ],
  "keep_vars": true,
  "limits": { "cpu_ms": 300000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": {
      "enabled": true
    },
    // Issues は Wrangler 4.134.0 以上が必要。ここで有効にしないと次のデプロイで無効に戻る。
    "issues": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // 同一ドメイン・パス分割: デスクトップアプリ向け API のみ受ける。
  // /api/auth・/api/contents・/api/stripe は beutl-web が処理するためパターンに含めない。
  "routes": [
    {
      "pattern": "beutl.beditor.net/api/v1/*",
      "zone_name": "beditor.net"
    },
    {
      "pattern": "beutl.beditor.net/api/v2/*",
      "zone_name": "beditor.net"
    },
    {
      "pattern": "beutl.beditor.net/api/v3/*",
      "zone_name": "beditor.net"
    }
  ],
  "hyperdrive": [
    {
      "binding": "BEUTL_DATABASE_HYPERDRIVE",
      "id": "34ad44345f2f45ea97c3608b0567a878"
    }
  ],
  // MUST MATCH beutl-web: both Workers read and write the same objects.
  // BEUTL_STORAGE_PROVIDER=s3 (vars) + BEUTL_S3_* (vars/secrets) sends new
  // objects to S3 compatible storage; keep this binding so objects already in
  // R2 stay readable. See docs/deployment.md#object-storage.
  "r2_buckets": [
    {
      "binding": "BEUTL_R2_BUCKET",
      "bucket_name": "beutl-dev"
    }
  ],
  "durable_objects": {
    // Hosted Git uses a separate Backblaze B2 S3 bucket, not BEUTL_R2_BUCKET.
    "bindings": [
      { "name": "BEUTL_GIT_REPOSITORIES", "class_name": "GitRepositoryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "git-repositories-v1", "new_sqlite_classes": ["GitRepositoryDurableObject"] }
  ],
  "vars": {
    // MUST MATCH beutl-web (apps/web/wrangler.jsonc)
    "JWT_EXPIRATION_MINUTES": "5",
    "JWT_REFRESH_TOKEN_EXPIRATION_DAYS": "30",
    "OPENROUTER_REQUEST_TIMEOUT_MS": "120000",
    "VERCEL_AI_GATEWAY_REQUEST_TIMEOUT_MS": "120000",
    "PUBLIC_ORIGIN": "https://beutl.beditor.net",
    "BEUTL_GIT_ENABLED": "false"
  }
}
